alert tcp 10.10.4.0/24 any -> !$HOME_NET any (msg:"Outbound traffic from specific device to Internet"; sid:9000001; rev:1; classtype:web-application-activity ;)
alert tcp 10.10.5.0/24 any -> $HOME_NET 445 (msg:"Unauthorized SMB from guest"; flow:to_server; sid:9000002; rev:1; classtype:unusual-client-port-connection ;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"High TCP Payload Alert"; flow:established; threshold: type threshold, track by_src, count 1, seconds 300; sid:9000003; rev:1; classtype:web-application-activity ;)
alert dns any any -> any any (msg:"DNS - Possible tunneling via long subdomain label"; dns.query; pcre:"/^[a-zA-Z0-9+\/=]{40,}\./"; sid:9000004; rev:1; classtype:denial-of-service ;)
alert tcp 10.10.2.0/24 any -> !10.10.2.15 3306 (msg:"TCP 3306 traffic from workstation not to billing server"; flow:to_server; sid:9000005; rev:1; classtype:unusual-client-port-connection ;)
alert telnet any any -> 10.10.4.0/24 23 (msg:"Telnet traffic to 10.10.4.0/24"; flow:to_server; sid:9000006; rev:1; classtype:targeted-activity ;)
